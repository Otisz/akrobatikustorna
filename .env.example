DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_HOST=mysql
DB_PREFIX=wp_

WP_ENV=development
WP_HOME=http://localhost:8080
WP_SITEURL=${WP_HOME}/wp

# The local administrator created on first start. Local only; production and
# staging accounts are created by hand.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.test

# The Site Owner's local account, which holds the Editor role. The browser tests
# sign in as this account, so that what they exercise is what the Site Owner can
# actually do.
WP_OWNER_USER=owner
WP_OWNER_PASSWORD=owner
WP_OWNER_EMAIL=owner@example.test

# The mailbox every email the site sends is carried by, over SMTP (Simple Mail
# Transfer Protocol). The password belongs here and nowhere else: it is never
# committed. Why the site does not use the server's own mail transport is in
# docs/adr/0010-mail-goes-over-smtp-because-a-lost-password-reset-is-a-lockout.md.
#
# Locally these point at Mailpit, which accepts everything, delivers nothing, and
# shows what was sent at http://localhost:8025. Production and staging point at
# smtp.gmail.com:587 with `tls` and a Gmail app password, where SMTP_USER and
# MAIL_FROM must both be the club's account: Gmail refuses to send as anyone else.
# Every deployed environment sets SMTP_HOST — without it the site falls back to the
# server's own transport, which is the lockout the ADR is about.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENCRYPTION=none
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=akrobatikustorna@gmail.com

# Staging only. The one password the staging site is shut behind, which the Site
# Owner and the developer share — staging holds a copy of the club's real content,
# so it is reachable by them and by nobody else. Set on the staging site and
# nowhere else: the gate is inert unless WP_ENV=staging, and a staging site whose
# password is unset serves nothing at all rather than serving everything. See
# docs/adr/0012-staging-is-shut-in-php-so-the-gate-deploys-with-the-site.md.
# STAGING_USER=staging
# STAGING_PASSWORD=

# The club's PostHog analytics property, which visitors are asked about before it
# loads. Both are needed: either one unset means no analytics at all, so that no
# environment is guessed into reporting somewhere. The host is the one the club's
# own property answers on, which differs by region. Left unset locally —
# development falls back to a key and a host that reach nothing, so the consent
# gate can be exercised without adding to the club's figures.
# POSTHOG_KEY=
# POSTHOG_HOST=

# Generate with: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
