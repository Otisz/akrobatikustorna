{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "44rem",
      "wideSize": "74rem"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "Tinta", "color": "#1c1f26" },
        { "slug": "ink-soft", "name": "Halvány tinta", "color": "#565d6b" },
        { "slug": "paper", "name": "Papír", "color": "#fdfdfc" },
        { "slug": "surface", "name": "Háttér", "color": "#f3f1ef" },
        { "slug": "line", "name": "Vonal", "color": "#e3dfda" },
        { "slug": "brand", "name": "Narancs", "color": "#e17c2e" },
        { "slug": "brand-strong", "name": "Erős narancs", "color": "#c2661f" },
        { "slug": "brand-deep", "name": "Mély narancs", "color": "#8f4a14" },
        { "slug": "brand-tint", "name": "Halvány narancs", "color": "#fcefe1" },
        { "slug": "gold", "name": "Arany", "color": "#f0e383" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fluid": true,
      "lineHeight": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Outfit",
          "fontFamily": "Outfit, ui-sans-serif, system-ui, sans-serif"
        },
        {
          "slug": "sans",
          "name": "Source Sans 3",
          "fontFamily": "'Source Sans 3', ui-sans-serif, system-ui, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Kicsi", "size": "0.9375rem" },
        { "slug": "medium", "name": "Alap", "size": "1.0625rem" },
        {
          "slug": "large",
          "name": "Nagy",
          "size": "1.5rem",
          "fluid": { "min": "1.25rem", "max": "1.5rem" }
        },
        {
          "slug": "x-large",
          "name": "Címsor",
          "size": "2rem",
          "fluid": { "min": "1.5rem", "max": "2rem" }
        },
        {
          "slug": "xx-large",
          "name": "Főcím",
          "size": "2.75rem",
          "fluid": { "min": "1.875rem", "max": "2.75rem" }
        }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": false,
      "units": ["rem", "%", "vw"],
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "20", "name": "Szűk", "size": "1rem" },
        { "slug": "30", "name": "Közepes", "size": "1.75rem" },
        { "slug": "40", "name": "Tágas", "size": "3rem" },
        { "slug": "50", "name": "Nagyon tágas", "size": "5rem" }
      ]
    },
    "border": { "color": false, "radius": false, "style": false, "width": false },
    "shadow": { "defaultPresets": false }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": { "left": "1.25rem", "right": "1.25rem" }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "lineHeight": "1.15",
          "letterSpacing": "-0.02em"
        },
        "color": { "text": "var(--wp--preset--color--ink)" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--brand-deep)" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "color": { "text": "var(--wp--preset--color--ink)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--brand-strong)",
          "text": "#ffffff"
        },
        "border": { "radius": "9999px" },
        "spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "textDecoration": "none"
        },
        ":hover": { "color": { "background": "var(--wp--preset--color--brand-deep)" } }
      },
      "caption": {
        "color": { "text": "var(--wp--preset--color--ink-soft)" },
        "typography": { "fontSize": "var(--wp--preset--font-size--small)" }
      }
    },
    "blocks": {
      "core/image": { "border": { "radius": "1rem" } },
      "core/quote": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "var(--wp--preset--font-size--large)" },
        "border": { "left": { "color": "var(--wp--preset--color--brand)", "style": "solid", "width": "3px" } },
        "spacing": { "padding": { "left": "1.5rem" } }
      },
      "core/table": {
        "typography": { "fontSize": "var(--wp--preset--font-size--medium)" }
      }
    }
  }
}
